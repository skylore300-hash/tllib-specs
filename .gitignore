# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Test, type-checker, linter, and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local Python environments and environment files
.venv/
venv/
.env
.env.*
!.env.example

# Python packaging/build outputs
build/
dist/
*.egg-info/

# Editor and OS metadata
.idea/
.vscode/
.DS_Store

# Local validation diagnostics
handoff-validation.log
pipeline-evidence.json
